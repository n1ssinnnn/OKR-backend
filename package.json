  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "better-auth": "^1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^1.0.0-rc.5",
    "elysia": "^1.4.30",
