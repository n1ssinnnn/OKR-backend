{
  "name": "okr-backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.3",
    "@elysia/openapi": "^1.4.17",
    "@paralleldrive/cuid2": "^3.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "better-auth": "^1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "postgres": "^4.0.0"
  },
  "scripts": {
    "generate": "bunx --bun drizzle-kit generate --config=packages/db/drizzle.config.ts --name ${name}",
    "dev": "bun --env-file .env --filter app --elide-lines=0 dev",
    "dev:local": "bun --env-file .env.local --filter app --elide-lines=0 dev",
    "db:local:up": "docker compose up -d db",
    "db:local:down": "docker compose down",
    "db:migrate:local": "bun --env-file .env.local drizzle-kit migrate --config=packages/db/drizzle.config.ts",
    "db:migrate:supabase": "bun --env-file .env drizzle-kit migrate --config=packages/db/drizzle.config.ts",
    "db:studio:local": "bun --env-file .env.local drizzle-kit studio --config=packages/db/drizzle.config.ts",
    "db:studio:supabase": "bun --env-file .env drizzle-kit studio --config=packages/db/drizzle.config.ts",
    "db:seed:local": "bun --env-file .env.local ./packages/db/seed.ts",
    "db:seed:supabase": "bun --env-file .env ./packages/db/seed.ts"
  }
}
